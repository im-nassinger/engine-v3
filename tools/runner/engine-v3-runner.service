[Unit]
Description=engine-v3 runner: one Claude session per step until v1 is done
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/engine-v3
EnvironmentFile=%h/.config/engine-v3-runner/env
Environment=PATH=%h/.nvm/versions/node/v26.13.0/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --who=engine-v3-runner --why="Building v1" --mode=block %h/.nvm/versions/node/v26.13.0/bin/node tools/runner/run.ts
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
